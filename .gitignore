# Ignore IDE configuration files
# The stuff stored here is user-specific and should not be committed
/.vscode/*
/ros/.vscode/*
.idea/
# The only exception are the launch configurations and the recommened extensions
!/ros/.vscode/launch.json
!/ros/.vscode/c_cpp_properties.json
!/.vscode/extensions.json

# Ignore ROS stuff
devel/
logs/
build/
install/
log/
bin/
lib/
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
build_isolated/
devel_isolated/

# Generated by dynamic reconfigure
*.cfgc
/cfg/cpp/
/cfg/*.py

# Ignore generated docs
*.dox
*.wikidoc

# eclipse stuff
.project
.cproject

# qcreator stuff
CMakeLists.txt.user

srv/_*.py
*.pcd
*.pyc
qtcreator-*
*.user

/planning/cfg
/planning/docs
/planning/src

*~

# Emacs
.#*

# Catkin custom files
CATKIN_IGNORE

# Drawio backup files
*.drawio.bkp